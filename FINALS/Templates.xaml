<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FinalsButton" TargetType="Button">
        <Setter Property="Width" Value="220"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#E0E0E0"/>
        <Setter Property="Background" Value="#1B1C20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border"
                        CornerRadius="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для компактного ListBox -->
    <Style x:Key="CompactBuildListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="8,6"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="2"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2a2a2a"/>
                                        <Setter Property="BorderBrush" Value="#FFD700"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#333366"/>
                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="BuildTemplate">
        <Border Background="#2a2a2a" BorderBrush="#444" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,6" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок и описание -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Название}" FontSize="32" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Описание}" FontSize="18" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Левая часть - основная информация -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <!-- Основное изображение -->
                    <Border Background="#1a1a1a" CornerRadius="6" Padding="6" Margin="0,0,0,10">
                        <Image x:Name="imgSpecialization" Source="{Binding Фотобилд}" Stretch="Uniform" Height="250"/>
                    </Border>

                    <!-- Класс -->
                    <Border Background="#1a1a1a" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Класс" FontSize="16" Foreground="#888" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Класс.Наименование}" FontSize="18" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1a1a1a" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#333" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                                <Image Source="{Binding Специализация.Фото}" Stretch="Uniform" Height="120" Width="120"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Специализация" FontSize="16" Foreground="#888" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Специализация.Наименование}" FontSize="18" FontWeight="Bold" Foreground="White"
       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Оружие -->
                    <Border Background="#1a1a1a" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#333" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                                <Image Source="{Binding Оружие.Фото}" Stretch="Uniform" Height="120" Width="120"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Оружие" FontSize="16" Foreground="#888" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Оружие.Наименование}" FontSize="18" FontWeight="Bold" Foreground="White"
       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Border Background="#1a1a1a" CornerRadius="5" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Гаджеты" FontSize="16" Foreground="#888" Margin="0,0,0,6" FontWeight="Bold"/>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <!-- Гаджет 1 -->
                                <Border Background="#252525" CornerRadius="4" Padding="6" Margin="4,0,0,10" 
>
                                    <StackPanel>
                                        <Border Background="#333" CornerRadius="3" Padding="2" Margin="0,0,0,6">
                                            <Image Source="{Binding Гаджет1.Фото}" Stretch="Uniform" Height="145" Width="145"/>
                                        </Border>
                                        <TextBlock Text="{Binding Гаджет1.Наименование}" FontSize="14" Foreground="White" 
           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                                    </StackPanel>
                                </Border>

                                <!-- Гаджет 2 -->
                                <Border Background="#252525" CornerRadius="4" Padding="6" Margin="4,0,0,10" 
>
                                    <StackPanel>
                                        <Border Background="#333" CornerRadius="3" Padding="2" Margin="0,0,0,6">
                                            <Image Source="{Binding Гаджет2.Фото}" Stretch="Uniform" Height="145" Width="145"/>
                                        </Border>
                                        <TextBlock Text="{Binding Гаджет2.Наименование}" FontSize="14" Foreground="White" 
           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                                    </StackPanel>
                                </Border>

                                <!-- Гаджет 3 -->
                                <Border Background="#252525" CornerRadius="4" Padding="6" Margin="4,0,0,16" 
>
                                    <StackPanel>
                                        <Border Background="#333" CornerRadius="3" Padding="2" Margin="0,0,0,6">
                                            <Image Source="{Binding Гаджет3.Фото}" Stretch="Uniform" Height="145" Width="145"/>
                                        </Border>
                                        <TextBlock Text="{Binding Гаджет3.Наименование}" FontSize="14" Foreground="White" 
           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#1a1a1a" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Резервный набор" FontSize="18" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Конфигурация_резерв}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252525" CornerRadius="4" Padding="8" Margin="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#333" CornerRadius="3" Padding="2">
                                                <Image Source="{Binding Предмет.Фото}" Stretch="Uniform" Height="100" Width="100"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Предмет.Наименование}" FontSize="16" Foreground="White" 
                                       VerticalAlignment="Center" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Дата_создания, StringFormat='Создано: {0:dd.MM.yyyy}'}" 
               FontSize="14" Foreground="#888" HorizontalAlignment="Right"/>
                        <TextBlock Text="Автор: " Margin="5,0,0,0" FontSize="14" Foreground="#888" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Автор.Фамилия}" Margin="1,0,0,0" FontSize="14" Foreground="#888" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Автор.Имя}" Margin="3,0,0,0" FontSize="14" Foreground="#888" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Автор.Отчество}" Margin="3,0,0,0" FontSize="14" Foreground="#888" HorizontalAlignment="Right"/>
                    </StackPanel>

                </Border>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>