<Window x:Class="FINALS.Мои_Конфигурации"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:FINALS"
        mc:Ignorable="d"
            Title="Мои конфигурации" Height="550" Width="1000" MinHeight="800" MinWidth="1500" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="186*"/>
            <ColumnDefinition Width="523*"/>
            <ColumnDefinition Width="239*"/>
        </Grid.ColumnDefinitions>

        <Image Source="/img/mybuilds.jpg" Stretch="Fill" Grid.ColumnSpan="4">
            <Image.Effect>
                <BlurEffect Radius="20"/>
            </Image.Effect>
        </Image>
        <ListBox x:Name="BuildsListBox" 
         Margin="10,0,10,0"
         ItemTemplate="{StaticResource BuildTemplate}"
         Style="{StaticResource CompactBuildListBoxStyle}" Grid.Column="2"/>
        <Button Content="НАЗАД" Margin="10,0,10,10" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="#FFD21E3B" FontWeight="Bold" FontStyle="Italic" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Click="Button_Click_1"/>
        <Button Content="РЕДАКТИРОВАТЬ" Margin="10,143,10,0" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="{x:Null}" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" Foreground="White" BorderBrush="{x:Null}" VerticalAlignment="Top" FontSize="24" Click="Button_Click_3" />
        <Button x:Name="CREATE" Content="СОЗДАТЬ" Margin="10,99,10,0" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="{x:Null}" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" Foreground="White" BorderBrush="{x:Null}" VerticalAlignment="Top"  FontSize="24" Click="CREATE_Click" />
        <Label Content="МОИ КОНФИГУРАЦИИ" Margin="10,10,10,0" VerticalAlignment="Top" Foreground="White" FontWeight="Bold" FontStyle="Italic" FontSize="28" Height="64" Grid.ColumnSpan="2"/>
        <Button x:Name="send" Content="ОТПРАВИТЬ" Margin="10,12,10,0" Height="38" Width="NaN" Style="{StaticResource FinalsButton}" Background="{x:Null}" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" Foreground="White" BorderBrush="{x:Null}" VerticalAlignment="Top" FontSize="24" Click="send_Click" />
        <Label x:Name="fioLabel" Content="FIO" Margin="10,0,10,94" Foreground="White" FontWeight="Bold" FontStyle="Italic" FontSize="20" Grid.ColumnSpan="2" Height="36" VerticalAlignment="Bottom"/>
        <Label x:Name="userIdLabel" Content="ID" Margin="10,0,10,62" Foreground="White" FontWeight="Bold" FontStyle="Italic" Grid.ColumnSpan="2" FontSize="20" Height="35" VerticalAlignment="Bottom"/>
        <Button Content="ИЗБРАННОЕ ★" Margin="10,0,10,10" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="Gold" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" BorderBrush="{x:Null}" FontSize="24" Foreground="#FF545454" VerticalAlignment="Bottom" Click="Button_Click_2" />
        <Button x:Name="publishButton" Content="ОПУБЛИКОВАТЬ" Margin="10,55,10,0" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="{x:Null}" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" Foreground="White" BorderBrush="{x:Null}" VerticalAlignment="Top"  FontSize="24" Click="publishButton_Click" />
        <Button Content="ПОЧТА ✉" Margin="10,187,10,0" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" FontWeight="Bold" FontStyle="Italic" Foreground="White" VerticalAlignment="Top" Grid.Column="3" FontSize="24" Click="Button_Click">
            <Button.BorderBrush>
                <ImageBrush/>
            </Button.BorderBrush>
            <Button.Background>
                <ImageBrush/>
            </Button.Background>
        </Button>
    </Grid>
</Window>
