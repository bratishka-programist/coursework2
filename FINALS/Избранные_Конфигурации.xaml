<Window x:Class="FINALS.Избранные_Конфигурации"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FINALS"
        mc:Ignorable="d"
            Title="Избранные конфигурации" Height="550" Width="1000" MinHeight="800" MinWidth="1500" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="186*"/>
            <ColumnDefinition Width="523*"/>
            <ColumnDefinition Width="239*"/>
        </Grid.ColumnDefinitions>

        <Image Source="/img/favorit.jpg" Stretch="Fill" Grid.ColumnSpan="4">
            <Image.Effect>
                <BlurEffect Radius="20"/>
            </Image.Effect>
        </Image>
        <ListBox x:Name="BuildsListBox" 
         Margin="10,0,10,0"
         ItemTemplate="{StaticResource BuildTemplate}"
         Style="{StaticResource CompactBuildListBoxStyle}" Grid.Column="2"/>
        <Button x:Name="back" Content="НАЗАД" Margin="10,0,10,10" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="#FFD21E3B" FontWeight="Bold" FontStyle="Italic" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Click="back_Click"/>
        <Button Content="ОТПРАВИТЬ БИЛД" Margin="10,0,10,10" Height="38" Width="NaN" Style="{StaticResource FinalsButton}" Background="#FF2BBB1F" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" Foreground="White" BorderBrush="{x:Null}" FontSize="24" VerticalAlignment="Bottom" Click="Button_Click" />
        <TextBlock Text="ИЗБРАННЫЕ КОНФИГУРАЦИИ" Margin="10,10,10,0" TextWrapping="Wrap" VerticalAlignment="Top" FontWeight="Bold" FontStyle="Italic" Foreground="White" Grid.ColumnSpan="2" FontSize="28" TextAlignment="Center"/>
        <Label x:Name="fioLabel" Content="FIO" Margin="10,0,10,94" Foreground="White" FontWeight="Bold" FontStyle="Italic" FontSize="20" Grid.ColumnSpan="2" Height="36" VerticalAlignment="Bottom"/>
        <Label x:Name="userIdLabel" Content="ID" Margin="10,0,10,62" Foreground="White" FontWeight="Bold" FontStyle="Italic" Grid.ColumnSpan="2" FontSize="20" Height="35" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
