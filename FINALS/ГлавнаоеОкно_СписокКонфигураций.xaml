<Window x:Class="FINALS.ГлавнаоеОкно_СписокКонфигураций"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FINALS"
        mc:Ignorable="d"
        Title="Опубликованные конфигурации" Height="550" Width="1000" MinHeight="800" MinWidth="1500" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="186*"/>
            <ColumnDefinition Width="523*"/>
            <ColumnDefinition Width="239*"/>
        </Grid.ColumnDefinitions>

        <Image Source="img/spisokkonf.jpg" Stretch="Fill" Grid.ColumnSpan="4">
            <Image.Effect>
                <BlurEffect Radius="20"/>
            </Image.Effect>
        </Image>

        <!-- ListBox в центральной колонке -->
        <ListBox x:Name="BuildsListBox" 
                 Grid.Column="2" 
                 Margin="10,0,10,0"
                 ItemTemplate="{StaticResource BuildTemplate}"
                 Style="{StaticResource CompactBuildListBoxStyle}"/>

        <!-- Ваши существующие кнопки -->
        <Button x:Name="exit" Content="ВЫЙТИ" Margin="10,0,10,10" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="#FFD21E3B" FontWeight="Bold" FontStyle="Italic" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Click="exit_Click"/>
        <Button x:Name="favorite" Content="В ИЗБРАННОЕ ★" Margin="10,0,10,10" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="Gold" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" BorderBrush="{x:Null}" FontSize="24" VerticalAlignment="Bottom" Foreground="#FF545454" Click="favorite_Click" />
        <Button x:Name="myBuild" Content="МОИ КОНФИГУРАЦИИ" Margin="10,55,10,0" Height="39" Width="NaN" Style="{StaticResource FinalsButton}" Background="{x:Null}" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" Foreground="White" BorderBrush="{x:Null}" VerticalAlignment="Top" Click="MyBuild_Click" FontSize="24" />

        <Button x:Name="send" Content="ОТПРАВИТЬ" Margin="10,12,10,0" Height="38" Width="NaN" Style="{StaticResource FinalsButton}" Background="{x:Null}" FontStyle="Italic" FontWeight="Bold" Grid.Column="3" Foreground="White" BorderBrush="{x:Null}" VerticalAlignment="Top" FontSize="24" Click="send_Click" />
        <TextBlock Text="ОПУБЛИКОВАННЫЕ КОНФИГУРАЦИИ" Margin="10,10,10,0" TextWrapping="Wrap" VerticalAlignment="Top" FontWeight="Bold" FontStyle="Italic" Foreground="White" Grid.ColumnSpan="2" FontSize="28" TextAlignment="Center"/>
    </Grid>
</Window>